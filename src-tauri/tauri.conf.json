{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widgeto",
  "version": "0.1.0",
  "identifier": "dev.widgeto.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Widgeto \u2014 Widget Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}