{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widgeto",
  "version": "0.1.0",
  "identifier": "com.widgeto.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Widgeto",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Widgeto",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QkRBRkJBQkVEMzI0RkIKUldUN0pOTyt1cSs5bHIxcmtjYzhpNVFOM1h2S3FHNS9hWWhXMFY1MW54UUFCTWo3TEVjeDlPbWkK",
      "endpoints": [
        "https://github.com/mxqius/widgeto/releases/latest/download/latest.json"
      ]
    }
  }
}
